# Copy to .env and adjust as needed.
PORT=4000

# Postgres connection (matches docker-compose.yml defaults)
DATABASE_URL=postgres://forestwatch:forestwatch@localhost:5432/forestwatch

# Secret used to sign volunteer JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret

# Public base URL used to build absolute photo URLs in API responses.
PUBLIC_URL=http://localhost:4000

# Comma-separated list of allowed CORS origins (website dev server, etc.)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
